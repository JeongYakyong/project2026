# project2026 데이터 수집·서빙 crontab (서버 시간대 = KST 기준)
# KIM 발표 00/06/12/18 UTC = KST 09/15/21/03, 데이터 가용까지 안전마진 ~3h.
#   12 UTC 발표 = 21:00 KST, 가용 ~00:00 KST → 01시 이후 안정적으로 받힌다.
# 경로의 kimjourvanne 는 실제 서버 사용자명/clone 위치에 맞게 수정.
#
# ── 역할별 재구성 (2026-06-15, 전국/육지) ───────────────────────────────────
# "cron 한 줄 = 한 역할"로 분리 (PROJECT.md / next-session-api-cleanup):
#   ① 기상예보(KMA) → forecast_horizon   = run_collect_forecast.sh   (collect_forecast_new.py)
#   ② 실측(KPX+ASOS) → historical        = run_collect_land_new.sh   (collect_data_land_new.py)
#   ③ 서빙 체인 5→6→7 → est_horizon_land = run_serve_chain_land.sh   (serve_chain_land_new.py)
# 전국(육지)은 레거시 forecast 테이블을 더는 쓰지 않는다(기상=forecast_horizon, 예측=est_horizon_land).


# ════════════ 제주 (forecast_horizon 신규 경로로 정리, 2026-06-16) ════════════
# ① 기상예보(KIMR+KIMG, 일사 3지점) → forecast_horizon : collect_forecast_new 제주 네이티브.
#   --backfill 3 = 최신+직전 2 base 완결성 점검(완전 skip / 불완전 auto-resume, 육지와 동일 정책).
#   run_collect_forecast.sh 는 육지·제주가 같은 flock(collect_forecast.lock)을 공유한다
#   (KMA 동시 호출 차단=504 방지).  그래서 제주는 육지(1:30/4:30)보다 1시간 뒤(2:30/5:30)에
#   둬, 육지 실행이 끝나 lock 이 풀린 뒤 돌게 한다(겹치면 flock -n 으로 그 회차는 skip → 다음
#   회차/다음날 backfill 이 부족분 auto-resume).
#   ※ 대량 과거 백필·KIMR 504 펑크 보충은 core/backfill_jeju_forecast.py(KIMR/KIMG 2-패스,
#     --kimr-only) 를 수동으로 쓴다(서버 cron 아님 — API 한도).
30 2 * * * /home/kimjourvanne/project2026/deploy/run_collect_forecast.sh --region jeju --backfill 3
30 5 * * * /home/kimjourvanne/project2026/deploy/run_collect_forecast.sh --region jeju --backfill 3

# ② 실측 + 미래 DA : run_collect_jeju.sh.  **forecast 테이블 폐기(2026-06-20, G-22)** 후
#   build() 는 weather 를 더는 forecast 에 쓰지 않고, 미래 *_da(SMP D+1/D+2 DA 가격선·예상수요)만
#   historical 에 컬럼단위 UPSERT(upsert_da_to_historical, 실측 보존).  build_historical 은 과거
#   실측(*_jeju/asos/*_da).  즉 이 줄은 historical(실측+미래DA) 한 테이블만 채운다.
#   ※ 기상 예보는 ①(collect_forecast_new→forecast_horizon)이 정본 — build() 의 KIMR/KIMG fetch 는
#     현재 산출물 없음(추후 _da 만 받도록 build 경량화 여지).  --forecast-days 는 _da 윈도우 길이로만
#     의미(기본 2일이 D+1/D+2 SMP 에 충분 → 별도 7일 줄 폐지).
10 6,12,18 * * * /home/kimjourvanne/project2026/deploy/run_collect_jeju.sh

# ③ 서빙 체인 2→3 → est_horizon_jeju : 매일 1회 (06:30) — ①·② 완료 후 최신 base 수요·신재생→
#   net_load 를 est_horizon_jeju(예측 아카이브)에 적재.  로컬 추론(API 무관)이라 육지 서빙(06:00)
#   직후에 둔다(별도 lock).  legacy forecast 테이블은 건드리지 않는다.  기상/실측이 불완전하면
#   가능한 지평만 산출(원점 168h history 부족 base 는 skip → 다음날 갱신).  SMP(4단계)는 범위 밖.
30 6 * * * /home/kimjourvanne/project2026/deploy/run_serve_chain_jeju.sh

# ④ 서빙 SMP 2단계출력→4단계 : 매일 1회 (06:40) — ③ 직후.  est_horizon_jeju(net_load·수요) +
#   historical DA → SMP D+1·D+2 핵심3컬럼(est_smp·smp_neg_proba·smp_danger)을 est_smp_horizon_jeju 에
#   적재(serve_smp_horizon_jeju.py).  로컬 추론(API 무관)·forecast 미접촉.  최신 base 의 DA·history 가
#   불완전하면 가능한 지평만(다음날 갱신).
40 6 * * * /home/kimjourvanne/project2026/deploy/run_serve_smp_jeju.sh

# (폐기) run_collect_runs.sh --region jeju → 위 run_collect_forecast.sh --region jeju 로 대체.
#   collect_forecast_runs.py 는 collect_forecast_new 가 import 하는 라이브러리로는 남지만,
#   cron 직접 호출은 더는 하지 않는다(run_collect_runs.sh 도 미사용).


# ════════════ 전국/육지 (신규 3-cron) ════════════
# ② 실측: 매일 1회 (00:50) — KPX 육지 수급/발전/DA + ASOS-land → historical. forecast 무관.
50 0 * * * /home/kimjourvanne/project2026/deploy/run_collect_land_new.sh

# ① 기상예보: 12 UTC 발표(육지) D+15.5(=16일)까지 → forecast_horizon.
#   --backfill 3 = 최신+직전 2개 base 를 완결성 점검. 완전하면 skip(콜 없음),
#   불완전하면 그 base 만 재수집(auto-resume). 1차 01:30(12z 가용 직후) + 04:30 재시도.
#   → 12z 가 늦게 뜨거나 일부 실패해도 다음 시도/다음날 backfill 이 부족분을 채운다.
30 1 * * * /home/kimjourvanne/project2026/deploy/run_collect_forecast.sh --backfill 3
30 4 * * * /home/kimjourvanne/project2026/deploy/run_collect_forecast.sh --backfill 3

# ③ 서빙 체인: 매일 1회 (06:00) — ①·② 완료 후 최신 base 5→6→7 → est_horizon_land.
#   로컬 추론(API 무관). 기상이 불완전하면 가능한 지평만 산출(다음날 갱신).
0 6 * * * /home/kimjourvanne/project2026/deploy/run_serve_chain_land.sh

# ④ 서빙 도시가스(일단위): 매일 1회 (06:50) — 최신 base 의 forecast_horizon(기온) → est_horizon_citygas
#   (전국 일단위 도시가스 송출 추정, D+1~15).  육지 ① 기상예보(forecast_horizon)만 의존하고
#   ③ 서빙 체인(est_horizon_land)과는 무관 — 로컬 추론(API 무관)·별도 lock.  기상이 부족하면
#   가능한 지평만 산출(다음날 갱신).  forecast_horizon 만 있으면 ③보다 먼저 돌려도 되지만,
#   서빙을 한곳에 모으려고 ③ 뒤(06:50)에 둔다.
50 6 * * * /home/kimjourvanne/project2026/deploy/run_serve_citygas.sh

# ⑤ AI 브리핑(지평 밴드 6구간): 매일 1회 (07:00) — ③ 서빙 체인·④ 도시가스 뒤.  est_horizon_land
#   (최신 base 예측)만 읽어 D+1·D+2·D+3·단지평(D+4~5)·중지평(D+6~10)·장지평(D+11~15) '종합'
#   브리핑을 Gemini 로 생성해 ai_briefings.db 에 저장(gen_briefs_land.py).  KPX/KMA 수집 트리거
#   없음(DB만 읽음)·별도 lock.  GEMINI_API_KEY(.env) 필요·google-genai 설치 venv.  streamlit
#   메인·예측확인 탭이 이 저장본을 밴드 선택기로 표시한다.
0 7 * * * /home/kimjourvanne/project2026/deploy/run_gen_briefs.sh

# ⑥ 외부 전송 API(serve_api) 상시 기동 점검: 5분마다 살펴서 꺼져 있으면 다시 띄움(이미 떠 있으면
#   그냥 넘어감).  예측 시계열(/forecast)+AI 브리핑(/brief)+둘 묶음(/bundle)+Swagger(/docs)를 HTTP 로
#   외부에 노출(루브릭 'AI 활용 확산성').  est_horizon_land·ai_briefings.db 만 읽음 — 수집 트리거 없음·
#   별도 lock.  fastapi·uvicorn 설치 venv.  ★ 최초 1회는 손으로 띄운다: deploy/run_serve_api.sh
#   ★ 외부 노출은 ufw 가 아니라 Caddy 라우트로 한다(이 서버는 앱을 127.0.0.1 에 묶고 Caddy 가 80/443
#     에서만 받음 → Caddyfile 에 `handle_path /api/* { reverse_proxy localhost:8800 }` 한 줄, DEPLOY §9).
*/5 * * * * SERVE_API_ROOT_PATH=/api SERVE_API_HOST=127.0.0.1 /home/kimjourvanne/project2026/deploy/run_serve_api.sh


# ════════════ (준비됨) 기상예보 v2 컷오버 — 2026-07-04 KIM 개편 대응 ════════════
# 검증(격리 백필·컬럼 호환·A/B·서빙 dry-run) 통과 후 아래 절차로 교체한다
# (1. data_fetcher_and_db/REPORT_forecast_v2.md 의 컷오버 절차서 참고):
#   0) 사전: KMA API허브에서 메인 키 계정에 신규 API(nph-kim_nc_pt_txt2_std) "활용신청"
#      (현재 SUB3 키만 등록됨 — 미등록 키는 403.  kim2 가 등록된 키로 자동 전환하므로
#       동작은 하지만, 메인 키 등록이 정석)
#   1) 본 DB 백업(.bak) 후 격리분 병합: python core/collect_forecast_v2.py --merge --region both
#   2) 위 ①번 4줄(run_collect_forecast.sh 육지 2줄·제주 2줄)을 아래로 교체:
# 30 1 * * * /home/kimjourvanne/project2026/deploy/run_collect_forecast_v2.sh --backfill 3 --production
# 30 4 * * * /home/kimjourvanne/project2026/deploy/run_collect_forecast_v2.sh --backfill 3 --production
# 30 2 * * * /home/kimjourvanne/project2026/deploy/run_collect_forecast_v2.sh --region jeju --backfill 3 --production
# 30 5 * * * /home/kimjourvanne/project2026/deploy/run_collect_forecast_v2.sh --region jeju --backfill 3 --production
#   3) (선택) L010 아카이브 — 서빙 미연결, EDA 대기용 수집:
# 50 5 * * * /home/kimjourvanne/project2026/deploy/run_collect_l010.sh --region both --backfill 2 --production
#   4) 롤백 = 이 4줄을 지우고 기존 run_collect_forecast.sh 줄 복원 (구 수집기 무수정 보존).
#   ※ frcc(1h 운량 아카이브)는 등압면 GRIB 이라 밤 혼잡 시 느리고 부분 응답이 잦다.
#     새벽 수집이 자주 늦으면 위 4줄에 --skip-frcc 를 붙이고 아래 낮 시간 줄로 분리:
# 0 10 * * * cd /home/kimjourvanne/project2026/1.\ data_fetcher_and_db && .venv 경로의 python \
#            core/temp/backfill_frcc_cols.py --from $(date -d '3 days ago' +\%Y\%m\%d) --to $(date +\%Y\%m\%d)
#   ※ v2 는 R030(지역 3km) 1h 로 D+1~5 해상도를 복원하고 D+6~12 는 기존 NE57 경로 그대로.
#     기존 컬럼명·수식·반올림 동일 + 신규 컬럼(cape/cinn/hpbl·일사 직달/산란)만 추가.
#     서빙 cron(③~⑥)은 무변경.

# ════════════ (준비됨/선택) 자동 백필 — 지평 아카이브 확장 (EDA·재훈련용, 2026-07-05) ════════════
# 목적: R030/L010 개시일(2026-02-09)부터 146일 지평 아카이브를 격리 DB(data/v2_*.db)에 쌓는다
#   (신재생·급변동·ACSWDNB 계절/D+2~5 검증용).  ★서빙 무접촉 — --production 없음(격리 DB 전용).
# 안전장치:
#   ① --max-bases 33 = 실행당 33 base 만 수집(나머지는 다음날 resume-skip).  base 하나 ~1,743콜
#      (육지+제주, frcc·L010 제외) → 하루 ~5.7만콜.  운영 수집(~1.5만)과 합쳐 ~6만 (4키 풀 8만 대비
#      ~2만 여유 — gascast 운영 수집이 굶지 않게 8만을 다 쓰지 않는다).  약 5일이면 146 base 완료,
#      이후 실행은 전부 skip(콜 0)=자동 정지.
#   ② 시간대 07:30 = 운영 수집창(01:30~05:30)·서빙(06:00~07:00)·자정 KMA 혼잡을 모두 피함.
#      백필 1회 ~2–3시간(33 base × ~4.7분) → ~10시 종료(낮 KMA 한산).
#   ③ 격리 DB → 서빙·운영 DB 무영향.  중단·재개 안전(resume-skip).  롤백 = 이 한 줄 삭제.
#   ④ --production 절대 붙이지 말 것(붙이면 본 DB 적재).  로그는 wrapper 가 deploy/logs/
#      collect_forecast_v2_YYYYMM.log 로 남긴다(별도 리다이렉트 불필요).  wrapper 는 자체 flock
#      (v2 전용)이라 운영 수집과 락은 다르지만, 07:30 은 운영 수집창(01:30~05:30) 밖이라 안 겹친다.
# ※ ACSWDNB(누적 총일사)·cape/cinn/hpbl·80m 바람·직달/산란 컬럼이 함께 쌓인다(수집기 2026-07-05 갱신).
# 30 7 * * * /home/kimjourvanne/project2026/deploy/run_collect_forecast_v2.sh --backfill 146 --region both --max-bases 33


# ════════════ (폐기) 기존 전국 줄 — 위 신규로 대체. 서버에서 제거할 것 ════════════
#   아래 두 줄은 레거시 forecast 테이블(전국)을 갱신하던 것 — forecast 폐기로 더는 안 쓴다.
# 40 6,12,18 * * * /home/kimjourvanne/project2026/deploy/run_collect_land.sh
# 40 0 * * * /home/kimjourvanne/project2026/deploy/run_collect_land.sh --bases 1 --kimg-days 16
#   기존 run_collect_runs.sh(both) → 위에서 --region jeju 로 분리했으므로 both 호출은 쓰지 말 것.
